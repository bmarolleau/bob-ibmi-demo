# Article Management Web Application - Environment Variables
# Copy this file to .env.local and update with your IBM i server details

# API Base URL - IBM i Web Services endpoint
# Development example:
VITE_API_BASE_URL=http://your-ibmi-server:10010/web/services/article

# Production example:
# VITE_API_BASE_URL=https://production-ibmi.company.com/web/services/article

# Notes:
# - Replace 'your-ibmi-server' with your IBM i hostname or IP address
# - Replace '10010' with your IWS port number (default is usually 10010 or 10014)
# - The path '/web/services/article' should match your IWS deployment path
# - After creating .env.local, restart the development server (npm run dev)

